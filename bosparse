		['[']="BRACKET_LEFT"
		[']']="BRACKET_RIGHT"
		['{']="BRACE_LEFT"
		['}']="BRACE_RIGHT"
	)

	# -- Exceptions for bash variable naming (hyphen → underscore) --
	VN_EXCEPTIONS_ref=(
		['-']="_"
	)

	# -- Debug commands (testing only, not used in production) --
	DEBUG_CMDS_ref=(
		["QUIET"]="__quiet"
		["STANDARD"]="__standard"
		["EXTRA"]="__extra"
		["DEBUG"]="__debug"
