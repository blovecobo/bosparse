		# ["SAN"]="BP_Strings"
		# ["BAN"]="BP_Bools"
		["PAN"]="BP_Positionals"

		["FLD_SEP"]=":"
		["ELM_SEP"]="|"

		# ["HRNS_FLDS"]="${HRNS_FLDS[@]}"
		# ["PEF_TYPES"]="${PFE_TYPES[@]}"
		# ["RESYMS"]="${RESYMS[@]}"
		# ["REGEX_METACHARS"]="${REGEX_METACHARS[@]}"
