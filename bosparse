	)

	# -- MCG type prefix bp_definitions --
	MCG_TYPES_ref=(
		["dependency"]="enum:d"
		["Dependency"]="enum:D"
		["exclusion"]="enum:e"
		["master"]="enum:m"
		["Master"]="enum:M"
		["required"]="enum:r"
		["uniqueness"]="enum:u"
